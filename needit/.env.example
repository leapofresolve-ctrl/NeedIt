# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only Supabase key (bypasses RLS; used by webhooks). NEVER NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical public origin. Used for Stripe redirects, canonical tags, OG image
# URLs and the sitemap. In production this must be https://exprifi.com — if it
# is wrong or unset on Vercel, share cards break and crawlers see two hosts.
# See lib/site.ts.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Rate limiting (optional; falls back to per-instance memory) ──────────────
# Upstash Redis REST credentials. Without them the limiter still runs, but each
# serverless instance keeps its own counters — fine for a naive script, not for
# a distributed one. /api/health reports which mode is active.
# SERVER-ONLY. Never NEXT_PUBLIC_.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Error reporting (optional; falls back to server console) ────────────────
# Sentry DSN. lib/observability.ts posts directly to Sentry's store endpoint —
# no SDK dependency. SERVER-ONLY: a DSN in a public var is a public write
# endpoint into your issue stream.
SENTRY_DSN=

# Shared secret for the token-protected /api/metrics/* endpoints that the
# Claude agents (Morning Metrics Brief, Concierge Scout) call. Generate with
# `openssl rand -hex 32`. Server-only — NEVER a NEXT_PUBLIC_ var.
METRICS_API_TOKEN=your-long-random-token

# ── Stripe (test mode) ──────────────────────────────────────────────────────
# Secret + webhook secret are server-only. NEVER put them in a NEXT_PUBLIC_ var.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Publishable key is safe to expose (only needed if/when you add client-side Stripe.js).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
