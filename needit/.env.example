# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Server-only Supabase key (bypasses RLS; used by webhooks). NEVER NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site origin, used to build Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for the token-protected /api/metrics/* endpoints that the
# Claude agents (Morning Metrics Brief, Concierge Scout) call. Generate with
# `openssl rand -hex 32`. Server-only — NEVER a NEXT_PUBLIC_ var.
METRICS_API_TOKEN=your-long-random-token

# ── Stripe (test mode) ──────────────────────────────────────────────────────
# Secret + webhook secret are server-only. NEVER put them in a NEXT_PUBLIC_ var.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Publishable key is safe to expose (only needed if/when you add client-side Stripe.js).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
