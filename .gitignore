# Repo-root ignores. The app has its own .gitignore in needit/.

# macOS clutter — these were showing up as changes on every commit.
.DS_Store
**/.DS_Store

# Never commit environment files or backups of them, anywhere in the repo.
# (The app's own rule `.env*.local` did NOT catch `.env.local.bak`, which was
# sitting untracked with live Supabase and Stripe secret keys in it.)
.env
.env.*
!.env.example
*.bak

# Editor / OS noise
.vscode/
.idea/
Thumbs.db

# Installed agent tooling — skills, agents and design/skill vaults. These are
# libraries pulled in for Claude to use, not Exprifi source. ~500 files
# including .ttf font binaries and Python caches; committing them would bloat
# the repo and bury real diffs. Nothing here is deployed (Vercel root = needit/).
.claude/
.agents/
skill-vault/
design-vault/

# Python + coverage droppings from those skill scripts.
__pycache__/
*.pyc
.coverage
